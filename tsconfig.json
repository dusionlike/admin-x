{
  "compilerOptions": {
    "target": "ES2022",
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "@/*": ["./apps/admin/src/*"],
      "@admin-x/shared": ["./packages/shared/src/index.ts"]
    }
  }
}
