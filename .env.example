# Admin X API server
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
# Production must enforce TLS at the application or a trusted reverse proxy.
SECURE_TRANSPORT_REQUIRED=true
# Set true when deployed behind a load balancer with hot-redundant instances.
HA_ENABLED=false
INSTANCE_ID=admin-x-01
# Backup evidence is encrypted with this key and must be stored outside the database host.
BACKUP_ENCRYPTION_KEY=replace-with-a-dedicated-backup-key
# Email MFA is disabled by default. Configure SMTP from the System Configuration page.
# The key encrypts the SMTP password stored in SQLite and must be kept outside the database host.
EMAIL_SMTP_ENCRYPTION_KEY=replace-with-a-dedicated-email-config-key
# Local backups default to <database-directory>/backups.
# BACKUP_LOCAL_PATH=/absolute/path/to/local-backups
# Remote backups should point to a mounted encrypted backup site or object-storage gateway.
# BACKUP_REMOTE_PATH=/absolute/path/to/remote-backups
MALWARE_SCAN_MODE=signature-and-content
AUDIT_RETENTION_MONTHS=12
PERSONAL_DATA_RETENTION_DAYS=365
# Optional override; leave unset to use the deployment-relative database path.
# DATABASE_PATH=/absolute/path/to/data/admin-x.sqlite
